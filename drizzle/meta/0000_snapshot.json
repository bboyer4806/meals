        "grocery_needs_status": {
          "name": "grocery_needs_status",
          "value": "\"grocery_needs\".\"status\" in ('to_order', 'ordered', 'received')"
        },
        "grocery_needs_store": {
          "name": "grocery_needs_store",
          "value": "\"grocery_needs\".\"status\" = 'to_order' or \"grocery_needs\".\"store_id\" is not null"
        },
        "grocery_needs_ordered": {
          "name": "grocery_needs_ordered",
          "value": "\"grocery_needs\".\"status\" != 'ordered' or \"grocery_needs\".\"ordered_at\" is not null"
        },
        "grocery_needs_to_order": {
          "name": "grocery_needs_to_order",
          "value": "\"grocery_needs\".\"status\" != 'to_order' or \"grocery_needs\".\"ordered_at\" is null"
        },
        "grocery_needs_received": {
          "name": "grocery_needs_received",
          "value": "(\"grocery_needs\".\"status\" = 'received') = (\"grocery_needs\".\"received_at\" is not null)"
        }
